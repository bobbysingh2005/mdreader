{
  "name": "mdreader",
  "version": "1.0.0",
  "description": "A lightweight, accessible Markdown reader CLI that opens documents in your default browser.",
  "packageManager": "npm@11.19.0",
  "bin": {
    "mdreader": "./bin/mdreader.js"
  },
  "author": "bobby singh <bobbysingh2005@gmail.com>",
  "keywords": [
    "markdown",
    "reader",
    "cli",
    "accessibility",
    "screen-reader"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin/**",
    "docs/**",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "marked": "^18.2.0",
    "open": "^11.0.4",
    "sanitize-html": "^2.18.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node ./bin/mdreader.js",
    "test": "npm run build && node --test test/args.test.js test/file.test.js test/markdown.test.js test/sanitizer.test.js test/html.test.js test/temp.test.js test/browser.test.js test/integration.test.js",
    "check": "npm run format:check && npm run typecheck && npm test",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.js\" \"docs/**/*.md\" package.json tsconfig.json README.md AGENTS.md",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.js\" \"docs/**/*.md\" package.json tsconfig.json README.md AGENTS.md",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/sanitize-html": "^2.16.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
